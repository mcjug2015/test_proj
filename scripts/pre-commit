#!/usr/bin/env bash
#
# Pre-commit hook — local equivalent of .github/workflows/ci.yml
#
# Runs the same steps as CI, in the same order:
#   make-lock    -> pants generate-lockfiles
#   verify       -> pants lint check ::  &&  pants test unit ::  &&  pants test integration ::
#   generate-whl -> pants package ::
#
# Integration tests always run after unit tests, as their own pants invocation — never
# combined with or in parallel with the unit run (see CLAUDE.md "Laws of integration testing").
#
# Abort the commit if any step fails.
#
# To install (from the repo root):
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit   # if tracked in scripts/
# or simply keep this file at .git/hooks/pre-commit and make it executable:
#   chmod +x .git/hooks/pre-commit

set -euo pipefail

# Run from the repo root regardless of where git invokes the hook.
cd "$(git rev-parse --show-toplevel)"

echo "==> [verify] Validating autoformat and types"
pants lint check src/:: test/::

# Share a running spark-connect-test container across both test runs below, same as
# validate.sh does, instead of each falling back to its own local embedded Spark.
source scripts/detect_spark_connect.sh

echo "==> [verify] Running unit tests"
pants test --output=all test/:: -test/integration::

echo "==> [verify] Running integration tests"
pants test --output=all test/integration::
